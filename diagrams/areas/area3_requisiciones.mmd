    UNIDAD_ORGANIZATIVA |o--o{ USUARIO : "adscribe [P]"
    UNIDAD_ORGANIZATIVA ||--o{ REQUISICION : "solicita"
    USUARIO ||--o{ REQUISICION : "crea"
    USUARIO |o--o{ REQUISICION : "revisa y aprueba"
